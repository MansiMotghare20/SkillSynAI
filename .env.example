# SkillSyncAI Backend Environment Variables Template
# Copy this file to .env and configure actual values

# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local URI)
MONGODB_URI=mongodb://127.0.0.1:27017/skillsyncai

# Authentication (JWT)
JWT_SECRET=super_secure_skillsyncai_dev_secret_replace_in_prod
JWT_EXPIRES_IN=7d

# Frontend CORS Origin (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Python ML Microservice URL (FastAPI running locally or deployed)
PYTHON_ML_SERVICE_URL=http://127.0.0.1:8000

# AI / LLM Integration (Google Gemini or OpenAI-compatible endpoint)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_llm_api_key_here
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
